generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum ExpenseEntryType {
  SESSION
  PERIODIC
}

enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
  DUE
}

enum KotStatus {
  NEW
  PRINTED
  REPRINTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NOTPAID
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  FAILED
}
enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

model Shop {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  address       String?
  phone         String?
  email         String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  users         User[]
  categories    Category[]
  orders        Order[]
  kots          Kot[]
  payments      Payment[]
  dailyCounters DailyCounter[]
  salesSessions SalesSession[]
  expenses      Expense[]

  @@map("shops")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  shopId          String         @map("shop_id") @db.Uuid
  name            String
  email           String         @unique
  password        String
  role            UserRole
  isActive        Boolean        @default(true) @map("is_active")
  passwordChangedAt DateTime?      @map("password_changed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  shop            Shop           @relation(fields: [shopId], references: [id])
  refreshTokens   RefreshToken[]

  createdOrders   Order[]        @relation("OrderCreatedBy")
  createdKots     Kot[]          @relation("KotCreatedBy")
  createdPayments Payment[]      @relation("PaymentCreatedBy")
  openedSessions  SalesSession[] @relation("SessionOpenedBy")
  closedSessions  SalesSession[] @relation("SessionClosedBy")
  createdExpenses Expense[]      @relation("ExpenseCreatedBy")

  @@index([shopId])
  @@index([shopId, role])
  @@index([shopId, isActive])
  @@map("users")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  shop       Shop      @relation(fields: [shopId], references: [id])
  products   Product[]

  @@index([shopId])
  @@index([shopId, isActive])
  @@index([shopId, sortOrder])
  @@unique([shopId, name])
  @@map("categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  categoryId  String?     @map("category_id") @db.Uuid
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  kotItems    KotItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([categoryId, isActive])
  @@index([categoryId, sortOrder])
  @@map("products")
}


model SalesSession {
  id                 String         @id @default(uuid()) @db.Uuid
  shopId             String         @map("shop_id") @db.Uuid
  date               DateTime       @db.Date
  status             SessionStatus  @default(OPEN)

  openingCash        Decimal        @default(0) @map("opening_cash") @db.Decimal(12, 2)
  openingNote        String?        @map("opening_note")
  openedAt           DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  openedById         String         @map("opened_by") @db.Uuid

  closedAt           DateTime?      @map("closed_at") @db.Timestamptz(3)
  closedById         String?        @map("closed_by") @db.Uuid
  closingNote        String?        @map("closing_note")
  allowedClosingTime DateTime?      @map("allowed_closing_time") @db.Time(0)

  shop               Shop           @relation(fields: [shopId], references: [id])
  openedBy           User           @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedBy           User?          @relation("SessionClosedBy", fields: [closedById], references: [id])

  orders             Order[]
  kots               Kot[]
  payments           Payment[]
  expenses           Expense[]

  @@unique([shopId, date])
  @@index([shopId, status])
  @@index([shopId, openedAt])
  @@index([openedById])
  @@index([closedById])
  @@map("sales_sessions")
}

model Expense {
  id            String           @id @default(uuid()) @db.Uuid
  shopId         String           @map("shop_id") @db.Uuid
  sessionId      String?          @map("session_id") @db.Uuid

  entryType      ExpenseEntryType @map("entry_type")
  categoryName   String           @map("category_name")
  amount         Decimal          @default(0) @db.Decimal(12, 2)
  note           String?

  expenseDate    DateTime         @map("expense_date") @db.Date
  periodStart    DateTime?        @map("period_start") @db.Date
  periodEnd      DateTime?        @map("period_end") @db.Date

  createdById    String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop           Shop             @relation(fields: [shopId], references: [id])
  session        SalesSession?    @relation(fields: [sessionId], references: [id])
  createdBy      User?            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([shopId, entryType])
  @@index([shopId, expenseDate])
  @@index([shopId, categoryName])
  @@index([sessionId])
  @@index([createdById])
  @@index([periodStart, periodEnd])
  @@map("expenses")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  shopId          String        @map("shop_id") @db.Uuid
  sessionId       String        @map("session_id") @db.Uuid
  orderNo         String        @map("order_no")
  tokenNo         Int           @map("token_no")
  orderType       OrderType     @default(DINE_IN) @map("order_type")
  status          OrderStatus   @default(OPEN)
  kotStatus       KotStatus     @default(NEW) @map("kot_status")
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  note            String?
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?       @map("cancel_reason")
  localId         String?       @map("local_id")
  syncedAt        DateTime?     @map("synced_at") @db.Timestamptz(3)

  shop            Shop          @relation(fields: [shopId], references: [id])
  session         SalesSession  @relation(fields: [sessionId], references: [id])
  createdBy       User?         @relation("OrderCreatedBy", fields: [createdById], references: [id])

  orderItems      OrderItem[]
  kot             Kot?
  payments        Payment[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([shopId, tokenNo])
  @@index([sessionId])
  @@index([sessionId, tokenNo])
  @@index([sessionId, status])
  @@index([createdById])
  @@unique([sessionId, orderNo])
  @@unique([sessionId, tokenNo])
  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  productId  String?   @map("product_id") @db.Uuid
  name       String
  price      Decimal   @db.Decimal(12, 2)
  quantity   Decimal   @default(1) @db.Decimal(12, 2)
  total      Decimal   @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  order      Order     @relation(fields: [orderId], references: [id])
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Kot {
  id            String        @id @default(uuid()) @db.Uuid
  shopId        String        @map("shop_id") @db.Uuid
  sessionId     String        @map("session_id") @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  kotNo         String        @map("kot_no")
  status        KotStatus     @default(PRINTED)
  timesPrinted  Int           @default(1) @map("times_printed")
  note          String?
  printedAt     DateTime      @default(now()) @map("printed_at") @db.Timestamptz(3)
  createdById   String?       @map("created_by") @db.Uuid

  shop          Shop          @relation(fields: [shopId], references: [id])
  session       SalesSession  @relation(fields: [sessionId], references: [id])
  order         Order         @relation(fields: [orderId], references: [id])
  createdBy     User?         @relation("KotCreatedBy", fields: [createdById], references: [id])

  kotItems      KotItem[]

  @@index([shopId, printedAt])
  @@index([shopId, status])
  @@index([sessionId])
  @@index([createdById])
  @@unique([sessionId, kotNo])
  @@map("kots")
}

model KotItem {
  id         String    @id @default(uuid()) @db.Uuid
  kotId      String    @map("kot_id") @db.Uuid
  productId  String?   @map("product_id") @db.Uuid
  name       String
  quantity   Decimal   @db.Decimal(12, 2)
  note       String?

  kot        Kot       @relation(fields: [kotId], references: [id])
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([kotId])
  @@index([productId])
  @@map("kot_items")
}
model Payment {
  id           String         @id @default(uuid()) @db.Uuid
  shopId       String         @map("shop_id") @db.Uuid
  sessionId    String         @map("session_id") @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  method       PaymentMethod
  amount       Decimal        @db.Decimal(12, 2)
  referenceNo  String?        @map("reference_no")
  cashTendered Decimal?       @map("cash_tendered") @db.Decimal(12, 2)
  changeAmount Decimal?       @map("change_amount") @db.Decimal(12, 2)
  status       PaymentStatus  @default(COMPLETED)
  createdById  String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  shop         Shop           @relation(fields: [shopId], references: [id])
  session      SalesSession   @relation(fields: [sessionId], references: [id])
  order        Order          @relation(fields: [orderId], references: [id])
  createdBy    User?          @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([shopId, createdAt])
  @@index([shopId, method])
  @@index([shopId, status])
  @@index([sessionId])
  @@index([orderId])
  @@index([createdById])
  @@map("payments")
}

model DailyCounter {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  date       DateTime  @db.Date
  lastToken  Int       @default(0) @map("last_token")
  lastOrder  Int       @default(0) @map("last_order")
  lastKot    Int       @default(0) @map("last_kot")

  shop       Shop      @relation(fields: [shopId], references: [id])

  @@unique([shopId, date])
  @@map("daily_counters")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}